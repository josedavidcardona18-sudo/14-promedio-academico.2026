meta {
  name: Registro de sesión desde otro origen (403)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/sesion
  body: json
  auth: none
}

headers {
  Origin: https://malo.example
}

body:json {
  {
    "idToken": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  }
}

assert {
  res.status: eq 403
  res.body.error: eq Origen no permitido.
}
