meta {
  name: Registro de sesión con token inválido (401)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/sesion
  body: json
  auth: none
}

body:json {
  {
    "idToken": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  }
}

assert {
  res.status: eq 401
}

docs {
  No crea ninguna cookie.
}
