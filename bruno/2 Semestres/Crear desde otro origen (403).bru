meta {
  name: Crear desde otro origen (403)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/semestres
  body: json
  auth: bearer
}

headers {
  Origin: https://malo.example
}

auth:bearer {
  token: {{idToken}}
}

body:json {
  {
    "nombre": "x",
    "meta": 3
  }
}

assert {
  res.status: eq 403
  res.body.error: eq Origen no permitido.
}

docs {
  Defensa contra CSRF.
}
