meta {
  name: Quién soy (200)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/auth/yo
  body: none
  auth: bearer
}

auth:bearer {
  token: {{idToken}}
}

assert {
  res.status: eq 200
  res.body.usuario.rol: isString
  res.body.usuario.uid: isString
}

docs {
  La persona de la sesión verificada: `{ usuario: { uid, correo, rol } }`.
}
