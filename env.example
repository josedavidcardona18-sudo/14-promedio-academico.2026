# Copie este archivo a .env.local y ajuste los valores. NUNCA suba .env.local al repositorio.
# Todos los valores de este archivo son FALSOS: no hay secretos reales en el disco de desarrollo.

# URL pública del sitio (metadatos, sitemap y Open Graph). En producción se define en Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modo demostración: sin cuentas y con datos en memoria (se reinician al reiniciar el servidor).
# Con 1 queda activo; con 0 se desactiva. Si no se define, solo está activo en `npm run dev`
# cuando no hay Firebase configurado. En producción NUNCA se activa solo: sin Firebase, la API se
# cierra, y con credenciales de Firebase MODO_DEMO=1 se ignora (no puede abrir tu API). No lo pongas en Vercel.
# MODO_DEMO=1

# --- Firebase: SOLO SERVIDOR (cuenta de servicio del Admin SDK). Nunca con prefijo NEXT_PUBLIC_. ---
# Consola de Firebase → Configuración del proyecto → Cuentas de servicio → Generar clave privada.
# En este archivo: una sola línea, entre comillas dobles y con los \n tal como salen del .json.
# En Vercel: pegue el valor sin las comillas de afuera (con \n o con saltos de línea reales).
FIREBASE_PROJECT_ID=mi-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@mi-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nFALSA\n-----END PRIVATE KEY-----\n"

# --- Firebase: configuración WEB (pública por diseño; no es un secreto) ---
# Consola de Firebase → Configuración del proyecto → Tus apps → App web.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaFALSA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mi-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mi-proyecto
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
