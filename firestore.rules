rules_version = '2';

// Firestore NO se usa desde el navegador: toda lectura y escritura pasa por la API (Route
// Handlers con el Admin SDK, que no se rige por estas reglas). Por eso aquí todo está cerrado:
// aunque alguien obtenga la configuración pública de Firebase, no puede leer ni escribir nada.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
